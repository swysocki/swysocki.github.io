---
permalink: /garage/index.html
title: Garage
---
{% extends "base.njk" %}

{% block content %}
<div class="intro">
  <h1 class="intro-title">Garage</h1>
  <p class="intro-bio">Automotive modifications, repairs, and upgrades documented one weekend at a time.</p>
</div>

<section class="notes-section">
  <h2 class="section-title">Builds</h2>
  <div class="posts-list">
    {% set currentYear = "" %}
    {% for post in collections.garage %}
      {% set postYear = post.date | readableDate("yyyy") %}
      {% if postYear != currentYear %}
        {% set currentYear = postYear %}
        <div class="year-group">
          <h3 class="year-title">{{ currentYear }}</h3>
        </div>
      {% endif %}
      <div class="post-item">
        <time class="post-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("MMM dd") }}</time>
        <a class="articlelist" href="{{ post.url }}">{{ post.data.title }}</a>
        <div class="tag-list">
          {% for tag in post.data.tags %}
            <span class="tag tag-{{ tag | slugify }}">{{ tag }}</span>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <p class="intro-bio">No builds yet. Check back soon.</p>
    {% endfor %}
  </div>
</section>
{% endblock %}
