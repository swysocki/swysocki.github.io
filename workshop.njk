---
permalink: /workshop/index.html
title: Workshop
---
{% extends "base.njk" %}

{% block content %}
<section class="featured-projects">
  <div class="project-grid">
    <div class="project-card">
      <h3 class="project-title"><a href="/workshop/e30/">e30</a></h3>
      <p class="project-description">The ongoing revival of a BMW e30. Suspension, engine, and interior work documented one weekend at a time.</p>
    </div>
    <div class="project-card">
      <h3 class="project-title"><a href="/workshop/fabrication/">Fabrication</a></h3>
      <p class="project-description">Welding, metalwork, and shop tooling. Brackets, jigs, and the occasional over-engineered fix.</p>
    </div>
    <div class="project-card">
      <h3 class="project-title"><a href="/workshop/home/">Home</a></h3>
      <p class="project-description">House projects and repairs. Practical improvements, from the mundane to the mildly ambitious.</p>
    </div>
  </div>
</section>

<section class="notes-section">
  <h2 class="section-title">Builds</h2>
  <div class="posts-list">
    {% set currentYear = "" %}
    {% for post in collections.workshop %}
      {% set postYear = post.date | readableDate("yyyy") %}
      {% if postYear != currentYear %}
        {% set currentYear = postYear %}
        <div class="year-group">
          <h3 class="year-title">{{ currentYear }}</h3>
        </div>
      {% endif %}
      <div class="post-item">
        <time class="post-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("MMM dd") }}</time>
        <a class="articlelist" href="{{ post.url }}">{{ post.data.title }}</a>
        <span class="tag tag-workshop">workshop</span>
      </div>
    {% else %}
      <p class="intro-bio">No workshop builds yet. Check back soon.</p>
    {% endfor %}
  </div>
</section>
{% endblock %}
