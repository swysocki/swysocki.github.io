---
permalink: /index.html
---
{% extends "base.njk" %}

{% block content %}
<div class="intro">
  <h1 class="intro-title">I build software, fabricate things, and write about my mistakes.</h1>
</div>

<section class="featured-projects">
  <h2 class="section-title">Projects</h2>
  <div class="project-grid">
    <div class="project-card">
      <h3 class="project-title">Tech</h3>
      <p class="project-description">Software, tools, and engineering notes documenting what I build and learn.</p>
    </div>
    <div class="project-card">
      <h3 class="project-title">Automotive</h3>
      <p class="project-description">Repairs, restorations, and modifications on project cars, one weekend at a time.</p>
    </div>
    <div class="project-card">
      <h3 class="project-title">Fabrication</h3>
      <p class="project-description">Welding, metalwork, and 3D printing from the workshop.</p>
    </div>
  </div>
</section>

<section class="notes-section">
  <h2 class="section-title">Notes</h2>
  <div class="posts-list">
    {% set currentYear = "" %}
    {% for post in collections.posts %}
      {% set postYear = post.date | readableDate("yyyy") %}
      {% if postYear != currentYear %}
        {% set currentYear = postYear %}
        <div class="year-group">
          <h3 class="year-title">{{ currentYear }}</h3>
        </div>
      {% endif %}
      <div class="post-item">
        <time class="post-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("MMM dd") }}</time>
        <a class="articlelist" href="{{ post.url }}">{{ post.data.title }}</a>
        <span class="category-tag">{{ post.data.category }}</span>
      </div>
    {% endfor %}
  </div>
</section>
{% endblock %}
