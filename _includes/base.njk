<!DOCTYPE html>
<html lang="en-US">
<head>
  {% block title %}<title>{{ title or "swysocki.com" }}</title>{% endblock %}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism.min.css">
  <link rel="stylesheet" href="/static/style.css" content-type="text/css">
</head>
<body>
{% set isWorkshop = (page.url and page.url.startsWith("/workshop/")) or (category == "workshop") %}
{% if isWorkshop %}
<header class="workshop-header">
  <a href="/" class="logo" aria-label="swysocki.com home"></a>
</header>
{% else %}
<header>
  <a href="/" class="logo-text">$ cat swysocki.com</a>
  <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden>
  <label for="nav-toggle" class="hamburger" aria-label="Toggle navigation">
    <span></span><span></span><span></span>
  </label>
  <nav>
    <a href="/">notes</a>
    <a href="/workshop/">workshop</a>
  </nav>
  <div class="header-right">
    <span class="status-indicator"><span class="status-dot"></span>sys: active</span>
  </div>
</header>
{% endif %}
<main>
{% block content %}
{% endblock %}
</main>
<footer>
  <p>brought to you by<a href="/"> swysocki.com </a> &#x1F919;</p>
</footer>
</body>
</html>
